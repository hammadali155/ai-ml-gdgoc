# Postgres
POSTGRES_USER=appuser
POSTGRES_PASSWORD=REPLACE_ME
POSTGRES_DB=appdb

# API
API_KEY=REPLACE_ME
APP_NAME="Docker Compose API"
ENVIRONMENT=compose
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_NAME=week2_day13_chunks

# Groq LLM
GROQ_API_KEY=REPLACE_ME
GROQ_MODEL=llama-3.1-8b-instant

# Embeddings
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- Day 16: Retrieval ---
DUAL_QUERY_ENABLED=true
NORMALIZATION_ENABLED=true
MERGED_SEARCH_LIMIT=5

# --- Day 17: Guardrails ---
MIN_TOP_SCORE_FOR_ANSWER=0.55
MIN_AVG_SCORE_FOR_ANSWER=0.45
MIN_RESULTS_FOR_ANSWER=2
ENABLE_CLARIFY_BEHAVIOR=true
ENABLE_REFUSE_BEHAVIOR=true
ENABLE_RAG_LOGGING=true

# --- Day 18: Agent Loop ---
ENABLE_AGENT_LOOP=true
MAX_AGENT_STEPS=4
ENABLE_AGENT_LOGGING=true
