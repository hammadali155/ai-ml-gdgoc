APP_NAME="Your App Name"
ENVIRONMENT="dev"
DEBUG=true
HOST="127.0.0.1"
PORT=8000
API_KEY="REPLACE_ME"
ALLOWED_ORIGINS="http://localhost:3000"
DATABASE_URL=postgresql://appuser:apppass@localhost:5432/appdb
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION_NAME=week2_day13_chunks
GROQ_API_KEY=REPLACE_ME
GROQ_MODEL=llama-3.1-8b-instant

# --- Day 17: Guardrails ---
MIN_TOP_SCORE_FOR_ANSWER=0.55
MIN_AVG_SCORE_FOR_ANSWER=0.45
MIN_RESULTS_FOR_ANSWER=2
ENABLE_CLARIFY_BEHAVIOR=true
ENABLE_REFUSE_BEHAVIOR=true
ENABLE_RAG_LOGGING=true

# --- Day 18: Agent Loop ---
ENABLE_AGENT_LOOP=true
MAX_AGENT_STEPS=4
ENABLE_AGENT_LOGGING=true
